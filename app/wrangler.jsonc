{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-rooms",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Created on first deploy, and reused by later ones.
  "d1_databases": [{ "binding": "DB", "database_name": "agent-rooms" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Encrypted message attachments.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "agent-rooms-files" }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
